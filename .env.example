# MOTIVA - Environment Variables

# ─────────────────────────────────────────────────────────────
# IA / LLM Configuration
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Model options:
# - gemini-1.5-flash (recommended for speed/cost)
# - gemini-1.5-pro (more accurate, slower)
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────
# Pipeline Configuration
# ─────────────────────────────────────────────────────────────
# Number of interviewees processed in parallel (default: 3)
BATCH_SIZE=3

# Number of previous insights used as context for cross-validation (default: 15)
CONTEXT_INSIGHTS_LIMIT=15

# ─────────────────────────────────────────────────────────────
# How to get Gemini API Key:
# ─────────────────────────────────────────────────────────────
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Create a new API key
# 3. Copy and paste below (replace 'your_gemini_api_key_here')
