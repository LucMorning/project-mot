# MOTIVA - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# AI / LLM Configuration
# ============================================================================

# Gemini API Key (required for AI analysis)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini Model to use
# Options: gemini-2.0-flash-exp, gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================================
# Pipeline Settings (Optional)
# ============================================================================

# Number of chunks processed in parallel (via asyncio.gather)
BATCH_SIZE=3

# Number of interviewees searched per round (SQL LIMIT)
BATCH_INTERVIEWEES=5

# Seconds between chunk batches
BATCH_SLEEP=10

# Maximum consecutive errors before stopping (rate limit protection)
BATCH_ERROR_THRESHOLD=5

# Number of previous insights used as context
CONTEXT_INSIGHTS_LIMIT=15

# ============================================================================
# Database (Optional - defaults to data/output/motiva.db)
# ============================================================================

# DB_PATH=data/output/motiva.db
